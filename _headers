# Cabeceras de los assets estaticos (Cloudflare Workers Static Assets).
# Sin esto todo sale con `max-age=0, must-revalidate`: el navegador revalida
# fuentes, fotos y vendor en cada visita. Los ficheros con hash en el nombre no
# existen aqui, asi que un cambio de imagen exige renombrarla.

/imgs/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# css y js no llevan hash en el nombre, asi que una semana de cache significaba
# una semana sirviendo la version vieja a quien ya habia entrado: se arreglaba
# algo y no lo veia nadie. no-cache no es "no guardes", es "pregunta antes de
# usar": el ETag devuelve 304 y no se baja nada si no ha cambiado.
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
