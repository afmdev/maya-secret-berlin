#!/bin/sh
# Despues de cada commit en main: despliega a Cloudflare y sube a GitHub.
#
# El workflow de .github/ solo hace curl a un deploy hook: devuelve 200, la
# Action sale verde y no despliega nada. El 17/10/2026 eso dejo la web cuatro
# commits atras durante dos horas sin un solo aviso. Hasta que ese hook este
# arreglado, el despliegue lo hace esta maquina.
#
# El push va aqui porque desplegar y subir son dos cosas distintas y se
# separaban solas: la web quedaba al dia y GitHub dos commits por detras.
#
# Se activa una vez por clon:
#     git config core.hooksPath scripts/hooks
#
# Ojo: wrangler sube lo que hay EN DISCO, no lo que acabas de commitear. Si
# quedan cambios sin commitear, tambien se publican.

# Git llama al hook con GIT_DIR apuntando al repo; sin limpiarlo, el push de
# abajo se ejecuta contra ese GIT_DIR y no contra el arbol de trabajo.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE

[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0

fallo=0

echo "post-commit: desplegando a Cloudflare..."
if npx --yes wrangler deploy; then
	echo "post-commit: desplegado."
else
	echo "post-commit: EL DESPLIEGUE HA FALLADO. La web sigue en la version anterior." >&2
	fallo=1
fi

echo "post-commit: subiendo a GitHub..."
if git push origin main; then
	echo "post-commit: subido."
else
	echo "post-commit: EL PUSH HA FALLADO. El commit esta solo en esta maquina." >&2
	fallo=1
fi

exit $fallo
